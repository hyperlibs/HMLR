{
  "manifest_version": 3,
  "name": "HMLR DevTools — HyperMedia Language Runtime Inspector",
  "version": "1.0.0",
  "description": "Multi-browser developer inspection layer for hypermedia velocity audits, reactive signals, 3D viewports, and agentic .mx telemetry.",
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "hmlr-devtools@hyperlibs.org",
      "strict_min_version": "109.0"
    },
    "safari": {
      "strict_min_version": "16.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
