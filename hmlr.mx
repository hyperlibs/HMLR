@type Subsystem = hmlr_core* | hmlr_wasm | compiler_fx | parser_mx | diagnostics | extension
@type NativeTarget = wasm32_unknown_unknown* | x86_64_pc_windows_msvc | x86_64_unknown_linux_gnu | aarch64_apple_darwin

@model ArchitectureLayer
  name: string
  subsystem: Subsystem
